# Copy to .env.local for `vercel dev`, or set these in the Vercel project
# dashboard (Settings -> Environment Variables) for Preview/Production.

# Auto-populated by Vercel when you connect a Neon Postgres DB via
# Dashboard -> Storage -> Marketplace -> Neon (see docs/PROGRESS.md).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string

# Any long random string. Vercel Cron automatically sends this as
# `Authorization: Bearer $CRON_SECRET` to /api/cron/* routes when set.
CRON_SECRET=change-me-to-a-long-random-string
